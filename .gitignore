/pkgbuild/*/
*.pkg.tar.*

# Flatpak build
.flatpak-builder/
/repo/
/build-aux/flatpak/cargo-sources.json

# Verification and source-package output
.gate-state/
/dist/
__pycache__/
*.pyc

# Review deliveries dropped here to be applied: archive material whose own
# links assume the repository root, so they also fail the link check.
/docs/*-DELIVERY/
