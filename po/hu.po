msgid "Opening the firewall port…"
msgstr "Tűzfal port megnyitása…"

#: crates/nd-gui/src/app.rs:67
msgid "Preparing the video…"
msgstr "Videó előkészítése…"

#: crates/nd-gui/src/app.rs:316
msgid "Scan again"
msgstr "Újra vizsgálat"

#: crates/nd-gui/src/app.rs:436 crates/nd-gui/src/app.rs:471
