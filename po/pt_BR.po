#: crates/nd-gui/src/app.rs:608
msgid "1 receiver found"
msgstr "1 receptor encontrado"

#: crates/nd-gui/src/app.rs:679
msgid "A stream is already running"
msgstr "Já existe uma transmissão em andamento"

#: crates/nd-gui/src/app.rs:382
msgid "A window"
msgstr "Uma janela"

#: crates/nd-gui/src/app.rs:46
msgid "AirPlay"
msgstr "AirPlay"

#: crates/nd-gui/src/app.rs:45
msgid "Chromecast"
msgstr "Chromecast"

#: crates/nd-gui/src/app.rs:839
msgid ""
"Chromecasts and TVs show up on their own. For Miracast, put the TV or the "
"projector into “Screen Mirroring” mode."
msgstr ""
"Chromecasts e TVs aparecem sozinhos. Para Miracast, coloque a TV ou o "
"projetor em “Espelhamento de Tela”."

#: crates/nd-gui/src/app.rs:64 crates/nd-gui/src/app.rs:696
msgid "Connecting…"
msgstr "Conectando…"

#: crates/nd-gui/src/app.rs:69
msgid "Failed"
msgstr "Falhou"

#: crates/nd-gui/src/app.rs:342
msgid "Got it"
msgstr "Entendi"

#: crates/nd-gui/src/app.rs:780
msgid "Local network discovery unavailable"
msgstr "Descoberta na rede local indisponível"

#: crates/nd-gui/src/app.rs:838
msgid "Looking for receivers…"
msgstr "Procurando receptores…"

#: crates/nd-gui/src/app.rs:47
msgid "Miracast"
msgstr "Miracast"

#: crates/nd-gui/src/app.rs:822
msgid ""
"Miracast does not work in the Flatpak build (it needs the system "
"NetworkManager)"
msgstr ""
"Miracast não funciona na versão Flatpak (precisa do NetworkManager do "
"sistema)"

#: crates/nd-gui/src/app.rs:829
msgid "Miracast unavailable"
msgstr "Miracast indisponível"

#: crates/nd-gui/src/app.rs:827
msgid "Miracast unavailable: this Wi-Fi card does not support Wi-Fi Direct"
msgstr "Miracast indisponível: esta placa Wi-Fi não suporta Wi-Fi Direct"

#: crates/nd-gui/src/app.rs:605
msgid "No receivers found"
msgstr "Nenhum receptor encontrado"

#: crates/nd-gui/src/app.rs:65
msgid "Opening the firewall port…"
msgstr "Liberando a porta no firewall…"

#: crates/nd-gui/src/app.rs:67
msgid "Preparing the video…"
msgstr "Preparando o vídeo…"

#: crates/nd-gui/src/app.rs:316
msgid "Scan again"
msgstr "Procurar novamente"

#: crates/nd-gui/src/app.rs:436 crates/nd-gui/src/app.rs:471
#: crates/nd-gui/src/app.rs:603
msgid "Searching…"
msgstr "Procurando…"

#: crates/nd-gui/src/app.rs:323
msgid "Stop"
msgstr "Parar"

#: crates/nd-gui/src/app.rs:668
msgid "Stopping…"
msgstr "Encerrando…"

#: crates/nd-gui/src/app.rs:68
msgid "Streaming"
msgstr "Transmitindo"

#: crates/nd-gui/src/app.rs:48
msgid "Test"
msgstr "Teste"

#: crates/nd-gui/src/app.rs:66
msgid "Waiting for the receiver…"
msgstr "Aguardando o receptor…"

#: crates/nd-gui/src/app.rs:362
msgid "What to share"
msgstr "O que transmitir"

#: crates/nd-gui/src/app.rs:371
msgid "Whole screen"
msgstr "Tela inteira"

#: crates/nd-gui/src/app.rs:220
msgid "discovery only"
msgstr "somente descoberta"

#: crates/nd-gui/src/app.rs:727
msgid "instant response"
msgstr "resposta imediata"

#: crates/nd-gui/src/app.rs:731
msgid "quick response"
msgstr "resposta rápida"

#: crates/nd-gui/src/app.rs:610
msgid "receivers found"
msgstr "receptores encontrados"

#: crates/nd-gui/src/app.rs:690
msgid "shows up in discovery only"
msgstr "aparece apenas na descoberta"

