+/// Information about the NDI runtime, without creating any sender or
+/// receiver.
+///
+/// Additions for BigNetScreen: applications need to tell "no runtime" apart
+/// from "runtime present but this CPU is not supported" and report the version
+/// they found, none of which the elements expose.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum RuntimeInfo {
+    /// The shared library could not be loaded; the message says where it was
+    /// looked for.
+    Missing(String),
+    /// The library loaded but `NDIlib_initialize` refused to run here.
+    CpuUnsupported { version: Option<String> },
+    /// Ready to use.
+    Ready { version: Option<String> },
+}
+
+/// Loads the runtime and asks it whether it can run on this machine.
+pub fn runtime_info() -> RuntimeInfo {
+    if let Err(err) = ndi::load() {
+        return RuntimeInfo::Missing(err.to_string());
+    }
+    let version = ndi::version();
+    if ndi::initialize() {
+        RuntimeInfo::Ready { version }
+    } else {
+        RuntimeInfo::CpuUnsupported { version }
+    }
+}
