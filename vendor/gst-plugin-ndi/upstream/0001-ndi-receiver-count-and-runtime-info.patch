+
+impl NdiSink {
+    /// Refreshes the `connections` property at most once per
+    /// `CONNECTIONS_INTERVAL`, notifying listeners when the count changes.
+    fn refresh_connections(&self, state: &mut State) {
+        let now = Instant::now();
+        if state
+            .last_connection_check
+            .is_some_and(|last| now.duration_since(last) < CONNECTIONS_INTERVAL)
+        {
+            return;
+        }
+        state.last_connection_check = Some(now);
+        let count = state.send.connections();
+        if self.connections.swap(count, Ordering::Relaxed) != count {
+            gst::debug!(CAT, imp = self, "{count} receiver(s) connected");
+            self.obj().notify("connections");
+        }
+    }
+}
