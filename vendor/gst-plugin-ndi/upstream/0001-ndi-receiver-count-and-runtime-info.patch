+/// Initialises the runtime; `false` means the CPU is not supported by it.
+///
+/// Requires [`load`] to have succeeded.
+pub fn initialize() -> bool {
+    unsafe { NDIlib_initialize() }
+}
+
+/// The runtime's version string. Requires [`load`] to have succeeded.
+pub fn version() -> Option<String> {
+    unsafe {
+        let ptr = NDIlib_version();
+        if ptr.is_null() {
+            None
+        } else {
+            Some(ffi::CStr::from_ptr(ptr).to_string_lossy().into_owned())
+        }
+    }
+}
